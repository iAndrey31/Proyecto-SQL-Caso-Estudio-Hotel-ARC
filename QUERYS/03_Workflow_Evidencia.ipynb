    "%sql\n",
    "SELECT\n",
    "    hotel,\n",
    "    COUNT(*) AS total_cancelaciones,\n",
    "    ROUND(AVG(adr), 2) AS precio_promedio_cancelacion\n",
    "FROM cursodataacademy.proyecto_hotel.hotel_bookings\n",
    "WHERE is_canceled = 1\n",
    "GROUP BY hotel\n",
    "ORDER BY precio_promedio_cancelacion DESC;"
